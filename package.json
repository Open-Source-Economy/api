{
  "name": "@open-source-economy/api-types",
  "version": "2.1.13",
  "description": "Shared API contracts for Open Source Economy platform",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Source-Economy/api.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "fmt:check": "prettier --check \"src/**/*.ts\"",
    "test": "echo \"No tests configured yet\" && exit 0",
    "ci": "npm run fmt && npm run lint && npm run build && npm test",
    "ci:check": "npm run fmt:check && npm run lint:check && npm run build && npm test",
    "ci:quick": "npm run fmt && npm run lint && npm run build",
    "ci:quick:check": "npm run fmt:check && npm run lint:check && npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ts-rest/core": "^3.53.0-rc.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "prettier": "^3.4.2",
    "semantic-release": "^24.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
